#!/bin/sh
# Work lands on main through PRs. The release script's version commit is the one exception.
# Turn on once per clone: git config core.hooksPath .githooks
[ "$(git symbolic-ref --short -q HEAD)" = main ] || exit 0
[ -n "${TB_RELEASE_COMMIT:-}" ] && exit 0
echo "Don't commit straight to main: commit on a branch and open a PR (git switch -c <branch>)." >&2
exit 1
